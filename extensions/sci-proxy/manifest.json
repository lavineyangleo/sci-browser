{
  "manifest_version": 3,
  "name": "sci-proxy",
  "version": "19.0.0",
  "description": "sci-proxy | SOCKS5 节点管理、代理切换与出口测试",
  "permissions": [
    "proxy",
    "storage",
    "privacy",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:17896/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_title": "sci-proxy"
  },
  "options_page": "options.html",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "key": ""
}