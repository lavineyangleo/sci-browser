{
  "manifest_version": 3,
  "name": "sci-cookie",
  "version": "1.0.0",
  "description": "读取当前网页 Cookie，脱敏查看并导出 web-cookie-skill 兼容快照。",
  "permissions": [
    "cookies",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "sci-cookie · 获取网页 Cookie",
    "default_popup": "popup.html",
    "default_icon": "assets/icon-128.png"
  },
  "icons": {
    "128": "assets/icon-128.png"
  },
  "key": ""
}